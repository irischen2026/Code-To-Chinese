# WutZit 1.0 - Local Environment Configurations
# Duplicate this file as '.env' or '.env.local' and fill in your keys.
# Do NOT commit '.env' or '.env.local' files to git control!

# Gemini API Key (from Google AI Studio)
VITE_GEMINI_KEY=AIzaSy...

# DeepSeek API Key (from platform.deepseek.com)
VITE_DEEPSEEK_KEY=sk-...

# OpenAI API Key (from platform.openai.com)
VITE_OPENAI_KEY=sk-proj-...

# Default Active Model on Startup ("gemini" | "deepseek" | "openai")
VITE_DEFAULT_MODEL=gemini
